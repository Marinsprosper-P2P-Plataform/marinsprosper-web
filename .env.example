# API do backend (NestJS, repositório separado: marinsprosper-api).
# Backend e frontend rodam em máquinas separadas — não existe backend
# em localhost. Ambiente de teste (VM Oracle Cloud, não é produção):
NEXT_PUBLIC_API_URL=https://api.163-176-220-125.sslip.io

# WebSocket do chat (Socket.IO, namespace /chat) — mesma origem da API
# acima; o client Socket.IO negocia o upgrade sozinho a partir de uma
# URL https. Sem servidor de WS separado.
NEXT_PUBLIC_WS_URL=https://api.163-176-220-125.sslip.io

# Antes de rodar contra o ambiente de teste, peça ao time de backend pra
# adicionar a origem local (ex. http://localhost:3000) em CORS_ORIGINS —
# sem isso o navegador bloqueia toda chamada antes de sair. Ver
# [[21 - Integração com API Real]] no vault Obsidian.
